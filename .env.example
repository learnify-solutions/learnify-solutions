# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password
ADMIN_EMAIL=info@learnify-solutions.com

# -------------------------------------------------------------
# Email / SMTP Configuration for Production Deployments
# -------------------------------------------------------------
# 1. Standard GoDaddy Secureserver / cPanel Webmail:
# SMTP_HOST=smtpout.secureserver.net
# SMTP_PORT=465 (or 587)
# EMAIL_USER=info@learnify-solutions.com
# EMAIL_PASSWORD=your_email_account_password

# 2. GoDaddy Microsoft 365 (Office 365):
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# EMAIL_USER=info@learnify-solutions.com
# EMAIL_PASSWORD=your_microsoft_password

# 3. Google Workspace / Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# EMAIL_USER=your_workspace_email@learnify-solutions.com
# EMAIL_PASSWORD=your_16_digit_google_app_password

# 4. Hostinger Webmail:
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# EMAIL_USER=info@learnify-solutions.com
# EMAIL_PASSWORD=your_hostinger_password

# Active SMTP Settings:
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
EMAIL_USER=info@learnify-solutions.com
EMAIL_PASSWORD=your_email_password

